{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackboxapproach.local/schema/data_structure.schema.json",
  "title": "BlackBoxApproach Data Structure",
  "type": "object",
  "required": ["id", "kind", "provenance", "fields"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
    },
    "kind": {
      "const": "data_structure"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "human_summary": {
      "type": "string"
    },
    "ai_reasoning": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": ["human_defined", "ai_defined", "mixed"]
    },
    "field": {
      "type": "object",
      "required": ["name", "type", "provenance"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "human_summary": {
          "type": "string"
        },
        "ai_reasoning": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
